@{
}

<div>
    <h3>Update Student Details</h3>
    <form method="post" action="/Student/Update/@Model.id">

<table>

    <tr>
                <td><label for="name">Name:</label></td>
                <td><input type="text" name="name" placeholder="Enter Name" value="@Model.name" /></td>

                
    </tr>

    <tr>

                <td><label for="department">Department:</label></td>
                <td><input type="text" name="department" placeholder="Enter Department" value="@Model.department" /></td>

    </tr>

    <tr>
                <td><label for="program">Program:</label></td>
                <td><input type="text" name="program" placeholder="Enter Program" value="@Model.program" /></td>
                
    </tr>
           

          <tr>
              <td></td>
                <td><button type="submit" class="btn btn-primary">Update</button></td>

                
          </tr>
                
</table>
        
    </form>
</div>