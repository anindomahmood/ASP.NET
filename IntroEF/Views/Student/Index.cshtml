@{
}

<div>
    <div>
        <h1>Welcome to the Student Portal</h1>
        <a href="@Url.Action("Create", "Student")" class="btn btn-primary">Add Student</a>
    </div>
    
    
  <table class="table">
       <thead>
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Program</th>
                <th>Actions</th>
            </tr>
        </thead>
        
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.name</td>
                    <td>@student.department</td>
                    <td>@student.program</td>
                    
                  <td>
                        <a href="@Url.Action("Edit", "Student", new { id = student.id })" class="btn btn-warning">Edit</a>
                        <a href="@Url.Action("Delete", "Student", new { id = student.id })" class="btn btn-danger">Delete</a>
                  </td>
                </tr>
            }
        </tbody>

</table>
</div>