@{
}

<div>
    <h1>Create Student</h1>
    <form method="post" action="/Student/Create">
       
        <table>
            <tr>
                <td>Name:</td>
                <td><input type="text" name="name" placeholder="Enter student name" /></td>
            </tr>
            <tr>
                <td>Department:</td>
                <td><input type="text" name="department" placeholder="Enter department" /></td>
            </tr>
            <tr>
                <td>Program:</td>
                <td><input type="text" name="program" placeholder="Enter program" /></td>
            </tr>

            <tr>
                <td></td>
                <td><button type="submit" class="btn btn-success">Create</button></td>
            </tr>
        </table>
        
    </form>    
</div>
